vllm-ascend v0.13.0: make the Ascend 310P (dav-m200) build work

Applied to a copy of deps/src/vllm-ascend by Dockerfile.aarch64 stage 6. Three
defects stop v0.13.0 from producing a loadable wheel for a 310P:

  1. The SoC gates read STREQUAL "ASCEND310P3" while setup.py's gen_build_info()
     only accepts the lowercase spelling, so no single SOC_VERSION satisfies
     both and the gates never fire -- handing 910B-only kernels to ccec.
  2. mla_preprocess is missing from the exclusion list, and the four LoRA
     entries are spelled so they expand to the wrong paths.
  3. The 310P branch drops batch_matmul_transpose's host tiling TU that
     torch_binding.cpp still calls, leaving vllm_ascend_C.so unimportable.

Fix: one case-insensitive SOC_IS_310P flag; exclude exactly what cannot build
for dav-m200; keep every host TU; add a stub TU defining the *_impl entry points
of the excluded kernels so the module links and raises instead of failing to
load. None of the stubbed ops is reachable on a 310P through vllm-ascend's own
Python dispatch.

Upstream ref: v0.13.0 (6281c12). Rebase on any bump of VLLM_ASCEND_REF.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6c55d93..5e0b9f4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -31,6 +31,18 @@ set(RUN_MODE "npu" CACHE STRING "cpu/sim/npu")
 set(SOC_VERSION ${SOC_VERSION})
 message(STATUS "Detected SOC version: ${SOC_VERSION}")
 
+# setup.py forwards SOC_VERSION verbatim and its gen_build_info() asserts it
+# against an all-lowercase table, so the gates below cannot be spelled
+# STREQUAL "ASCEND310P3" without forcing a value that fails that assert. Fold
+# the case once, and match the whole 310P family (310p1/3/5/7 and the vir*
+# variants) -- every member of it is AI Core arch dav-m200.
+string(TOLOWER "${SOC_VERSION}" SOC_VERSION_LOWER)
+set(SOC_IS_310P OFF)
+if(SOC_VERSION_LOWER MATCHES "^ascend310p")
+    set(SOC_IS_310P ON)
+endif()
+message(STATUS "Building for the 310P family: ${SOC_IS_310P}")
+
 if (NOT CMAKE_BUILD_TYPE)
   set(CMAKE_BUILD_TYPE "Release" CACHE STRINGS "Build type Release/Debug (default Release)" FORCE)
 endif()
@@ -61,15 +73,36 @@ set(VLLM_ASCEND_CUSTOM_OP
     ${CMAKE_CURRENT_SOURCE_DIR}/csrc/batch_matmul_transpose/op_kernel/batch_matmul_transpose_kernel.cpp
 )
 
+# Kernels that cannot be built for dav-m200, as real paths. The LoRA entries
+# were written `${KERNEL_FILES}/bgmv_expand.cpp`, but KERNEL_FILES is a ;-list
+# of absolute paths, so that expanded to every globbed kernel but the last plus
+# one nonexistent path -- dropping pos_encoding_kernels.cpp and
+# get_masked_input_and_mask_kernel.cpp, which do build here, and keeping a LoRA
+# kernel, which does not.
+#
+#   bgmv_*/sgmv_* - the device pass honours their
+#       `#if !defined(__CCE_AICORE__) || (__CCE_AICORE__ >= 220)` guard and
+#       emits no bf16 instantiation, but the host stub pass compiles with
+#       __CCE_AICORE__ undefined, so the guard opens and the launch of
+#       bgmv_shrink_bfloat16_t comes out "not configured".
+#   batch_matmul_transpose - uses PIPE_FIX, a sync pipe only on 910/910B, and
+#       an Adds over __bf16 that the dav_m200 implementation static_asserts on.
+#   mla_preprocess - was absent from this list, which is what breaks the 310P
+#       build: ArchType::ASCEND_V220 code instantiating MLAOperation over
+#       __bf16, which ccec rejects as "unknown type name 'bfloat16_t'".
+#
+# csrc/soc_stubs/unsupported_310p.cpp supplies the *_impl symbols that
+# csrc/torch_binding.cpp references for the ops these kernels back.
 set(VLLM_ASCEND_CUSTOM_OP_EXCLUDE
-    ${KERNEL_FILES}/bgmv_expand.cpp
-    ${KERNEL_FILES}/bgmv_shrink.cpp
-    ${KERNEL_FILES}/sgmv_expand.cpp
-    ${KERNEL_FILES}/sgmv_shrink.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/kernels/bgmv_expand.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/kernels/bgmv_shrink.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/kernels/sgmv_expand.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/kernels/sgmv_shrink.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/mla_preprocess/op_kernel/mla_preprocess_kernel.cpp
     ${CMAKE_CURRENT_SOURCE_DIR}/csrc/batch_matmul_transpose/op_kernel/batch_matmul_transpose_kernel.cpp
 )
 
-if(SOC_VERSION STREQUAL "ASCEND310P3")
+if(SOC_IS_310P)
     list(REMOVE_ITEM VLLM_ASCEND_CUSTOM_OP ${VLLM_ASCEND_CUSTOM_OP_EXCLUDE})
 endif()
 
@@ -79,15 +112,19 @@ ascendc_library(vllm_ascend_kernels SHARED
 
 message("TORCH_NPU_PATH is ${TORCH_NPU_PATH}")
 
-if(SOC_VERSION STREQUAL "ASCEND310P3")
-    file(GLOB VLLM_ASCEND_SRC
-    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/*.cpp
-    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/aclnn_torch_adapter/*.cpp)
-else()
-    file(GLOB VLLM_ASCEND_SRC
-    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/*.cpp
-    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/aclnn_torch_adapter/*.cpp
-    ${CMAKE_CURRENT_SOURCE_DIR}/csrc/batch_matmul_transpose/op_host/tiling/tiling_data.cpp)
+# tiling_data.cpp is ordinary host C++ and the only definition of
+# pp_matmul::GetPpMatmulTiling and HardwareInfo::HardwareInfo, which
+# csrc/torch_binding.cpp reaches through the header-defined
+# bmm_trans::batch_matmul_transpose_tiling. Excluding it on the 310P left
+# vllm_ascend_C.so unimportable, so it is built on every SoC.
+file(GLOB VLLM_ASCEND_SRC
+${CMAKE_CURRENT_SOURCE_DIR}/csrc/*.cpp
+${CMAKE_CURRENT_SOURCE_DIR}/csrc/aclnn_torch_adapter/*.cpp
+${CMAKE_CURRENT_SOURCE_DIR}/csrc/batch_matmul_transpose/op_host/tiling/tiling_data.cpp)
+
+if(SOC_IS_310P)
+    list(APPEND VLLM_ASCEND_SRC
+        ${CMAKE_CURRENT_SOURCE_DIR}/csrc/soc_stubs/unsupported_310p.cpp)
 endif()
 
 include_directories(
diff --git a/csrc/soc_stubs/unsupported_310p.cpp b/csrc/soc_stubs/unsupported_310p.cpp
new file mode 100644
index 0000000..f5c540d
--- /dev/null
+++ b/csrc/soc_stubs/unsupported_310p.cpp
@@ -0,0 +1,77 @@
+/*
+ * Ascend 310P (dav-m200) stand-ins for kernels that exist only on dav-c220.
+ *
+ * csrc/torch_binding.cpp registers every custom op unconditionally, while the
+ * top-level CMakeLists drops the kernel sources that cannot be compiled for
+ * dav-m200. Without these definitions vllm_ascend_C.so carries undefined *_impl
+ * symbols and fails to load, taking every other op in the module with it.
+ * Defining them keeps the module loadable and turns an unreachable call into a
+ * clear error: on a 310P none of these ops is reachable through vllm-ascend's
+ * own dispatch -- LoRA falls back to vllm.lora.ops.torch_ops in
+ * vllm_ascend/lora/punica_npu.py, and MLA and sparse attention are gated on
+ * AscendDeviceType._310P.
+ *
+ * Deliberately does not include ../ops.h: that header carries a non-inline
+ * definition of weak_ref_tensor(), so a second translation unit including it
+ * would be a duplicate symbol.
+ */
+
+#include <c10/util/Exception.h>
+#include <cstdint>
+
+#include "../kernels/types.h"
+
+namespace vllm_ascend {
+
+namespace {
+void unsupported_on_310p(const char *op)
+{
+    TORCH_CHECK(false, "vllm-ascend: '", op,
+                "' has no Ascend 310P (dav-m200) kernel - it is excluded at "
+                "build time because its Ascend C sources are dav-c220 only.");
+}
+}  // namespace
+
+void bgmv_shrink_impl(AscendType, void *, void *, void *, void *, uint32_t,
+                      void *, uint32_t, uint32_t, uint32_t, uint32_t, float)
+{
+    unsupported_on_310p("bgmv_shrink");
+}
+
+void bgmv_expand_impl(AscendType, void *, void *, void *, void *, uint32_t,
+                      void *, void *, uint32_t, uint32_t, uint32_t, uint32_t,
+                      uint32_t, uint32_t)
+{
+    unsupported_on_310p("bgmv_expand");
+}
+
+void sgmv_shrink_impl(AscendType, void *, void *, void *, void *, uint32_t,
+                      void *, uint32_t, void *, uint32_t, uint32_t, uint32_t,
+                      uint32_t, float)
+{
+    unsupported_on_310p("sgmv_shrink");
+}
+
+void sgmv_expand_impl(AscendType, void *, void *, void *, void *, uint32_t,
+                      void *, uint32_t, void *, void *, uint32_t, uint32_t,
+                      uint32_t, uint32_t, uint32_t, uint32_t)
+{
+    unsupported_on_310p("sgmv_expand");
+}
+
+void mla_preprocess_impl(void *, void *, void *, void *, void *, void *, void *,
+                         void *, void *, void *, void *, void *, void *, void *,
+                         void *, void *, void *, void *, void *, void *, void *,
+                         void *, void *, void *, void *, void *, void *, void *,
+                         void *, void *, void *, const uint32_t)
+{
+    unsupported_on_310p("mla_preprocess");
+}
+
+void batch_matmul_transpose_impl(void *, void *, void *, void *, void *,
+                                 const uint32_t)
+{
+    unsupported_on_310p("batch_matmul_transpose");
+}
+
+}  // namespace vllm_ascend
